# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/social-dashboard

# JWT
JWT_SECRET=replace_with_a_long_random_secret
